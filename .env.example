NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://library:library@localhost:5432/library
REDIS_URL=redis://localhost:6379
COLLEGE_DOMAIN=kiit.ac.in
R2_BUCKET=college-library-originals
MCP_SERVER_NAME=college-library
MCP_SERVER_VERSION=0.1.0
ADMIN_INGEST_TOKEN=replace-with-a-local-secret
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://library.runloop.in
PUBLIC_HOSTNAME=library.runloop.in
ACME_EMAIL=admin@example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://library.runloop.in/auth/google/callback
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
OAUTH_INTERNAL_SECRET=replace-with-at-least-16-random-characters
LIBRARY_DATA_DIR=local-ingest/data/processed
MCP_INCLUDE_PENDING=true
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
RAW_DATA_DIR=local-ingest/data/raw
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_OAUTH_MAX_REQUESTS=30
RATE_LIMIT_MCP_MAX_REQUESTS=60
