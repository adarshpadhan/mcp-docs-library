{
  "name": "mcp-college-library",
  "private": true,
  "version": "0.1.0",
  "description": "Open college learning library with a TypeScript MCP server",
  "license": "Apache-2.0",
  "packageManager": "npm@10",
  "workspaces": [
    "backend",
    "packages/*",
    "local-ingest",
    "cloudflare/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx backend/src/server.ts",
    "mcp:stdio": "tsx backend/src/stdio.ts",
    "dev:ingest": "tsx local-ingest/src/cli.ts",
    "dev:ingest:unlimited": "tsx local-ingest/src/cli.ts",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
